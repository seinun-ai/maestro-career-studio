{
  "manifest_version": 3,
  "name": "Maestro CS Companion",
  "version": "0.1.2",
  "minimum_chrome_version": "114",
  "description": "Save job postings into Maestro CS, autofill applications from your profile, and attach your tailored resume.",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "key": "",
  "permissions": ["storage", "tabs", "webNavigation", "scripting", "sidePanel"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "sw.js" },
  "side_panel": { "default_path": "panel/panel.html" },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": [
        "shared/decisions.js",
        "shared/choose.js",
        "shared/guided-run.js",
        "shared/policy.js",
        "shared/profile-fields.js",
        "content/job-posting.js",
        "content/eeo.js",
        "content/autofill.js",
        "content/open-questions.js",
        "content/detect.js",
        "content/agent.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": {
    "default_title": "Open the Maestro CS panel",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png" }
  },
  "commands": {
    "toggle-widget": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Open the Maestro CS panel on this page"
    }
  }
}
