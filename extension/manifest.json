{
  "manifest_version": 3,
  "name": "Maestro CS Companion",
  "version": "0.1.0",
  "description": "Save job postings into Maestro CS, autofill applications from your profile, and attach your tailored resume.",
  "key": "",
  "permissions": ["storage", "tabs", "webNavigation", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "sw.js" },
  "content_scripts": [
    {
      "matches": ["https://*/*", "http://*/*"],
      "js": [
        "content/job-posting.js",
        "content/policy.js",
        "content/eeo.js",
        "content/autofill.js",
        "content/open-questions.js",
        "content/detect.js",
        "content/agent.js",
        "content/widget.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ],
  "action": { "default_title": "Show the Maestro CS widget on this page" },
  "commands": {
    "toggle-widget": {
      "suggested_key": { "default": "Alt+Shift+J" },
      "description": "Show or hide the Maestro CS widget on this page"
    }
  }
}
