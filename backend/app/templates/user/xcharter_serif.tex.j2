%-------------------------
% Custom commands
\newcommand{\resumeItem}[1]{
  \item\small{#1}\vspace{-2pt}
}

\newcommand{\resumeSubheading}[4]{
  \vspace{-2pt}\item\small
    \begin{tabular*}{1.0\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{\small #1} & \textbf{\small #2} \\
      \textit{\small#3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item\small
    \begin{tabular*}{1.001\textwidth}{l@{\extracolsep{\fill}}r}
      \small#1 & \textbf{\small #2}\\
    \end{tabular*}\vspace{-7pt}
}

\newcommand{\resumeSubItem}[1]{\resumeItem{#1}\vspace{-4pt}}

((* if fmt.bullet_icon == "dash" *))
\renewcommand\labelitemi{--}
\renewcommand\labelitemii{--}
((* else *))
\renewcommand\labelitemi{$\vcenter{\hbox{\tiny$\bullet$}}$}
\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}
((* endif *))

% List parameters are pinned to the values `\small` installs in \@listi /
% \@listii for the 11pt article class (topsep 6/4.5, parsep 3/2), so the entry
% rhythm no longer depends on the ambient font size. `entry_spacing` rides on
% top of the pinned itemsep: 0 reproduces the original, each +1 adds 1pt.
\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0.0in, label={}, topsep=6pt, parsep=3pt, itemsep=((( fmt.entry_spacing + 3 )))pt]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}[topsep=4.5pt, parsep=2pt, itemsep=2pt]}
\newcommand{\resumeItemListEnd}{\end{itemize}\vspace{-5pt}}

%-------------------------------------------
\begin{document}

%----------HEADING----------
((* set contact = resume.contact *))
((* if fmt.header_align == "left" *))\begin{flushleft}((* elif fmt.header_align == "right" *))\begin{flushright}((* else *))\begin{center}((* endif *))
    {\Huge \scshape ((( contact.name|latex_escape )))} \\ \vspace{1pt}
    ((* if contact.location *))\small ((( contact.location|latex_escape ))) \\ \vspace{1pt}((* endif *))
    \small
    ((# The tie (~) is load-bearing: each contact line ends with a %-comment,
        and TeX discards the NEXT line's leading spaces after a comment — a
        plain leading space here is eaten, gluing the bar to the previous
        item (0pt gap, measured). ~ is not a space token, so it survives. #))
    ((* set sep = joiner("~$|$ ") *))
    ((* if contact.phone *))((( sep() )))((( contact.phone|latex_escape )))((* endif *))%
    ((* if contact.email *))((( sep() )))\href{mailto:((( contact.email|latex_escape_url )))}{\underline{((( contact.email|latex_escape )))}}((* endif *))%
    ((* if contact.linkedin *))((( sep() )))\href{https://((( contact.linkedin|latex_escape_url )))}{\underline{((( contact.linkedin|latex_escape )))}}((* endif *))%
    ((* if contact.github *))((( sep() )))\href{https://((( contact.github|latex_escape_url )))}{\underline{((( contact.github|latex_escape )))}}((* endif *))%
    ((* if contact.website *))((( sep() )))\href{https://((( contact.website|latex_escape_url )))}{\underline{((( contact.website|latex_escape )))}}((* endif *))
    \vspace{-8pt}
((* if fmt.header_align == "left" *))\end{flushleft}((* elif fmt.header_align == "right" *))\end{flushright}((* else *))\end{center}((* endif *))

((* if resume.summary *))
%-----------SUMMARY-----------
\section{Summary}
% Scoped: a bare \small here used to leak \small (and its \@listi list
% parameters) into the whole document, so heading sizes silently depended on
% whether the resume had a summary. \par inside the group keeps \small's
% baselineskip for the paragraph's last line.
{\small ((( resume.summary|latex_escape )))\par}
\vspace{-8pt}
((* endif *))

((* if resume.experience *))
%-----------EXPERIENCE-----------
\section{Experience}
  \resumeSubHeadingListStart
((* for exp in resume.experience *))
    \resumeSubheading
      {((( exp.company|latex_escape )))}{((* if exp.start_date and (exp.start_date|string|trim) *))((( exp.start_date|format_date(fmt.date_format)|latex_escape )))((* if exp.end_date and (exp.end_date|string|trim) *)) -- ((( exp.end_date|format_date(fmt.date_format)|latex_escape )))((* else *)) -- Present((* endif *))((* elif exp.end_date and (exp.end_date|string|trim) *))((( exp.end_date|format_date(fmt.date_format)|latex_escape )))((* endif *))}
      {((( exp.role|latex_escape )))}{((( exp.location|latex_escape )))}
      \resumeItemListStart
((* for bullet in exp.bullets *))
        \resumeItem{((( bullet|latex_escape )))}
((* endfor *))
      \resumeItemListEnd
((* endfor *))
  \resumeSubHeadingListEnd
\vspace{-16pt}
((* endif *))

((* if resume.projects and resume.projects|length > 0 *))
%-----------PROJECTS-----------
\section{Projects}
    \vspace{-5pt}
    \resumeSubHeadingListStart
((* for project in resume.projects *))
      \resumeProjectHeading
          {\textbf{((( project.name|latex_escape )))}((* if project.tech *)) $|$ \emph{((( project.tech|latex_escape )))}((* endif *))}{((( project.date|format_date(fmt.date_format)|latex_escape )))}
          \resumeItemListStart
((* for bullet in project.bullets *))
            \resumeItem{((( bullet|latex_escape )))}
((* endfor *))
          \resumeItemListEnd
((* if not loop.last *))
          \vspace{-13pt}
((* endif *))
((* endfor *))
    \resumeSubHeadingListEnd
\vspace{-3pt}
((* endif *))

((* for section in resume.extra_sections *))
((* if section.type == "entries" and section.entries *))
\section{((( section.title|latex_escape )))}
  \resumeSubHeadingListStart
((* for entry in section.entries *))
    \resumeSubheading
      {((( entry.heading|latex_escape )))}{((( entry.date|format_date(fmt.date_format)|latex_escape )))}
      {((( entry.subheading|latex_escape )))}{((( entry.location|latex_escape )))}
((* if entry.link or entry.bullets *))
      \resumeItemListStart
((* if entry.link *))
        \resumeItem{\href{((( entry.link|latex_escape_url )))}{\underline{((( entry.link|latex_escape )))}}}
((* endif *))
((* for bullet in entry.bullets *))
        \resumeItem{((( bullet|latex_escape )))}
((* endfor *))
      \resumeItemListEnd
((* endif *))
((* endfor *))
  \resumeSubHeadingListEnd
\vspace{-12pt}
((* elif section.type == "bullets" and section.bullets *))
\section{((( section.title|latex_escape )))}
  \resumeItemListStart
((* for bullet in section.bullets *))
    \resumeItem{((( bullet|latex_escape )))}
((* endfor *))
  \resumeItemListEnd
\vspace{-12pt}
((* endif *))
((* endfor *))

((* if resume.skills or resume.certifications *))
%-----------TECHNICAL SKILLS-----------
\section{Technical Skills}
((* if fmt.skills_layout == "bulleted" *))
 \begin{itemize}[leftmargin=0.15in, topsep=6pt, parsep=3pt, itemsep=3pt]
((* for group in resume.skills *))
    \small\item \textbf{((( group.category|latex_escape )))}: ((( group.items|map("latex_escape")|join(", ") )))
((* endfor *))
((* if resume.certifications *))
    \small\item \textbf{Certifications}: ((( resume.certifications|map("latex_escape")|join(", ") )))
((* endif *))
 \end{itemize}
((* else *))
 \begin{itemize}[leftmargin=0.15in, label={}, topsep=6pt, parsep=3pt, itemsep=3pt]
    \small{\item{
((* for group in resume.skills *))
     \textbf{((( group.category|latex_escape )))}: ((( group.items|map("latex_escape")|join(", ") )))((* if not loop.last or resume.certifications *)) \\((* endif *))
((* endfor *))
((* if resume.certifications *))
     \textbf{Certifications}: ((( resume.certifications|map("latex_escape")|join(", ") )))
((* endif *))
    }}
 \end{itemize}
((* endif *))
 \vspace{-16pt}
((* endif *))

((* if resume.education *))
%-----------EDUCATION-----------
\section{Education}
  \resumeSubHeadingListStart
((* for edu in resume.education *))
((* set edu_date = edu.start_date|format_date(fmt.date_format)|latex_escape if (edu.start_date and (edu.start_date|string|trim)) else edu.graduation_date|format_date(fmt.date_format)|latex_escape *))
((* set edu_date_range = edu_date ~ (" -- " ~ (edu.end_date|format_date(fmt.date_format)|latex_escape)) if (edu.start_date and (edu.start_date|string|trim) and edu.end_date and (edu.end_date|string|trim)) else edu_date *))
((* set edu_gpa = edu.gpa|latex_escape *))
((* set edu_degree = edu.degree|latex_escape *))
((* set edu_institution = edu.institution|latex_escape ~ ((", " ~ edu.location|latex_escape) if edu.location else "") *))
((* if fmt.education_order == "institution_first" *))
    \resumeSubheading
      {((( edu_institution )))}{((( edu_date_range )))}
      {((( edu_degree )))}{((( edu_gpa )))}
((* else *))
    \resumeSubheading
      {((( edu_degree )))}{((( edu_date_range )))}
      {((( edu_institution )))}{((( edu_gpa )))}
((* endif *))
((* if edu.coursework or edu.bullets *))
\resumeItemListStart
((* if edu.coursework *))
    \resumeItem{Coursework: ((( edu.coursework|map("latex_escape")|join(", ") ))).}
((* endif *))
((* for bullet in edu.bullets *))
    \resumeItem{((( bullet|latex_escape )))}
((* endfor *))
\resumeItemListEnd
((* endif *))
((* endfor *))
  \resumeSubHeadingListEnd

((* endif *))

\end{document}
