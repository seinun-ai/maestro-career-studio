\documentclass[letterpaper,((( fmt.font_size )))pt]{article}

\usepackage[letterpaper,
  lmargin=((( fmt.side_margins )))in, rmargin=((( fmt.side_margins )))in,
  tmargin=((( fmt.top_bottom_margin )))in, bmargin=((( fmt.top_bottom_margin )))in,
  headheight=0pt, headsep=0pt, footskip=0pt]{geometry}
\usepackage{titlesec}
\usepackage[usenames,dvipsnames]{color}
\usepackage{enumitem}
\usepackage[hidelinks]{hyperref}
\usepackage{fancyhdr}
\usepackage[english]{babel}
\usepackage{fontawesome5}
\input{glyphtounicode}

\pagestyle{fancy}
\fancyhf{}
\fancyfoot{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}

\urlstyle{same}
\raggedbottom
((* if not fmt.justify *))\raggedright((* endif *))
\linespread{((( fmt.line_spacing )))}
\setlength{\tabcolsep}{0in}

\titleformat{\section}{
  \vspace{-5pt}\scshape\large\bfseries
}{}{0em}{}[((* if not fmt.hide_divider *))\color{black}\titlerule ((* endif *))\vspace{((( fmt.section_spacing - 12 )))pt}]

\pdfgentounicode=1

\newcommand{\resumeItem}[1]{
  \item \small{#1}
}

\newcommand{\resumeSubheading}[4]{
  \item
    \begin{tabular*}{1.0\textwidth}[t]{l@{\extracolsep{\fill}}r}
      \textbf{#1} & \textbf{\small #2} \\
      \textit{\small #3} & \textit{\small #4} \\
    \end{tabular*}\vspace{-3pt}
}

\newcommand{\resumeProjectHeading}[2]{
    \item
    \begin{tabular*}{1.0\textwidth}{l@{\extracolsep{\fill}}r}
      \small #1 & \textbf{\small #2}\\
    \end{tabular*}\vspace{-3pt}
}

((* if fmt.bullet_icon == "dash" *))
\renewcommand\labelitemi{--}
\renewcommand\labelitemii{--}
((* else *))
\renewcommand\labelitemi{$\vcenter{\hbox{\tiny$\bullet$}}$}
\renewcommand\labelitemii{$\vcenter{\hbox{\tiny$\bullet$}}$}
((* endif *))

\newcommand{\resumeSubHeadingListStart}{\begin{itemize}[leftmargin=0in, label={}, itemsep=((( fmt.entry_spacing )))pt]}
\newcommand{\resumeSubHeadingListEnd}{\end{itemize}}
\newcommand{\resumeItemListStart}{\begin{itemize}[leftmargin=0.18in, itemsep=0pt, topsep=1pt, parsep=0pt, partopsep=0pt]}
\newcommand{\resumeItemListEnd}{\end{itemize}}

\begin{document}

((* set contact = resume.contact *))
((* include '_header.tex.j2' *))

((* if resume.summary *))
\section{Summary}
\small
((( resume.summary|latex_escape )))
\vspace{((( fmt.section_spacing - 12 )))pt}
((* endif *))

((* if resume.experience *))
\section{Experience}
\resumeSubHeadingListStart
((* for exp in resume.experience *))

\resumeSubheading
  {((( exp.company|latex_escape )))}{((( exp.start_date|format_date(fmt.date_format)|latex_escape )))((* if exp.end_date *)) -- ((( exp.end_date|format_date(fmt.date_format)|latex_escape )))((* endif *))}
  {((( exp.role|latex_escape )))}{((( exp.location|latex_escape )))}
  \resumeItemListStart
((* for bullet in exp.bullets *))
    \resumeItem{((( bullet|latex_escape )))}
((* endfor *))
  \resumeItemListEnd
((* endfor *))

\resumeSubHeadingListEnd
\vspace{((( fmt.section_spacing - 18 )))pt}
((* endif *))

((* if resume.projects and resume.projects|length > 0 *))
\section{Projects}
\resumeSubHeadingListStart
((* for project in resume.projects *))

\resumeProjectHeading
  {\textbf{((( project.name|latex_escape )))}((* if project.tech *)) $|$ \emph{((( project.tech|latex_escape )))}((* endif *))}{((( project.date|format_date(fmt.date_format)|latex_escape )))}
  \resumeItemListStart
((* for bullet in project.bullets *))
    \resumeItem{((( bullet|latex_escape )))}
((* endfor *))
  \resumeItemListEnd
((* endfor *))

\resumeSubHeadingListEnd
\vspace{((( fmt.section_spacing - 18 )))pt}
((* endif *))

((#
  Custom (extra) resume sections. Rendered here — the documented phase-1 anchor:
  after Projects, before Technical Skills. resume_for_render() has already
  dropped disabled sections and disabled entries, so we only iterate visible
  content; empty sections (a title with no entries/bullets) are skipped so no
  lone header or empty itemize (a LaTeX error) is emitted. The heading layout is
  reused from Experience (\resumeSubheading: heading + date, subheading +
  location); a bullets section is a flat item list. Every user string passes
  through latex_escape.
#))
((* for section in resume.extra_sections *))
((* if section.type == "entries" and section.entries *))
\section{((( section.title|latex_escape )))}
\resumeSubHeadingListStart
((* for entry in section.entries *))

\resumeSubheading
  {((( entry.heading|latex_escape )))}{((( entry.date|format_date(fmt.date_format)|latex_escape )))}
  {((( entry.subheading|latex_escape )))}{((( entry.location|latex_escape )))}
((* if entry.link or entry.bullets *))
  \resumeItemListStart
((* if entry.link *))
    \resumeItem{\href{((( entry.link|latex_escape_url )))}{\underline{((( entry.link|latex_escape )))}}}
((* endif *))
((* for bullet in entry.bullets *))
    \resumeItem{((( bullet|latex_escape )))}
((* endfor *))
  \resumeItemListEnd
((* endif *))
((* endfor *))

\resumeSubHeadingListEnd
\vspace{((( fmt.section_spacing - 18 )))pt}
((* elif section.type == "bullets" and section.bullets *))
\section{((( section.title|latex_escape )))}
\resumeItemListStart
((* for bullet in section.bullets *))
  \resumeItem{((( bullet|latex_escape )))}
((* endfor *))
\resumeItemListEnd
\vspace{((( fmt.section_spacing - 18 )))pt}
((* endif *))
((* endfor *))

((* if resume.skills or resume.certifications *))
\section{Technical Skills}
((* if fmt.skills_layout == "bulleted" *))
\begin{itemize}[leftmargin=0.15in]
((* for group in resume.skills *))
  \small\item \textbf{((( group.category|latex_escape )))}: ((( group.items|map("latex_escape")|join(", ") )))
((* endfor *))
((* if resume.certifications *))
  \small\item \textbf{Certifications}: ((( resume.certifications|map("latex_escape")|join(", ") )))
((* endif *))
\end{itemize}
((* else *))
\begin{itemize}[leftmargin=0.15in, label={}]
  \small\item{
((* for group in resume.skills *))
    \textbf{((( group.category|latex_escape )))}: ((( group.items|map("latex_escape")|join(", ") )))((* if not loop.last or resume.certifications *)) \\((* endif *))
((* endfor *))
((* if resume.certifications *))
    \textbf{Certifications}: ((( resume.certifications|map("latex_escape")|join(", ") )))
((* endif *))
  }
\end{itemize}
((* endif *))
\vspace{((( fmt.section_spacing - 18 )))pt}
((* endif *))

((* if resume.education *))
\section{Education}
\resumeSubHeadingListStart
((* for edu in resume.education *))

((* set edu_date = edu.start_date|format_date(fmt.date_format)|latex_escape if edu.start_date else edu.graduation_date|format_date(fmt.date_format)|latex_escape *))
((* set edu_date_range = edu_date ~ (" -- " ~ (edu.end_date|format_date(fmt.date_format)|latex_escape)) if (edu.start_date and edu.end_date) else edu_date *))
((* set edu_gpa = edu.gpa|latex_escape *))
((* set edu_degree = edu.degree|latex_escape *))
((* set edu_institution = edu.institution|latex_escape ~ ((", " ~ edu.location|latex_escape) if edu.location else "") *))
((* if fmt.education_order == "institution_first" *))
\resumeSubheading
  {((( edu_institution )))}{((( edu_date_range )))}
  {((( edu_degree )))}{((( edu_gpa )))}
((* else *))
\resumeSubheading
  {((( edu_degree )))}{((( edu_date_range )))}
  {((( edu_institution )))}{((( edu_gpa )))}
((* endif *))
((* if edu.coursework or edu.bullets *))
  \resumeItemListStart
((* if edu.coursework *))
    \resumeItem{Coursework: ((( edu.coursework|map("latex_escape")|join(", ") ))).}
((* endif *))
((* for bullet in edu.bullets *))
    \resumeItem{((( bullet|latex_escape )))}
((* endfor *))
  \resumeItemListEnd
((* endif *))
((* endfor *))

\resumeSubHeadingListEnd
((* endif *))

\end{document}
