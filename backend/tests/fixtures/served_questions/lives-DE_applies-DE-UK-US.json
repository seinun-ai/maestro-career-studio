        },
        {
          "key": "willing_to_relocate",
          "label": "Willing to relocate?",
          "type": "select",
          "boolean": true,
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        {
          "key": "how_heard",
          "label": "How did you hear about the job?"
        }
      ]
    }
  ],
