    {
      "key": "eeo",
      "title": "Diversity questions (voluntary)",
      "fields": [
        {
          "key": "veteran_status",
          "label": "Are you a veteran?",
          "type": "select",
          "options": [
            {
              "value": "no",
              "label": "No, I am not a veteran"
            },
            {
              "value": "yes",
              "label": "Yes, I am a veteran"
            },
            {
              "value": "decline",
              "label": "I don't wish to answer"
            }
          ],
          "staleHint": "Answer again: this question changed."
        },
        {
          "key": "disability_status",
          "label": "Disability status",
          "type": "select",
          "options": [
            {
              "value": "no",
              "label": "No, I do not have a disability"
            },
            {
              "value": "yes",
              "label": "Yes, I have a disability"
            },
            {
              "value": "decline",
              "label": "Decline to answer"
            }
          ]
        },
        {
          "key": "gender",
          "label": "Gender",
          "type": "select",
          "options": [
            {
              "value": "male",
              "label": "Male"
            },
            {
              "value": "female",
              "label": "Female"
            },
            {
              "value": "non_binary",
              "label": "Non-binary"
            },
            {
              "value": "self_describe",
              "label": "Prefer to self-describe"
            },
            {
              "value": "decline",
              "label": "Decline to answer"
            }
          ]
        },
        {
          "key": "gender_self_describe",
          "label": "How you describe your gender",
          "optional": true,
          "hint": "The Companion types this where a form asks you to self-describe.",
          "when": [
            "gender",
            "self_describe"
          ]
        },
        {
          "key": "hispanic_latino",
          "label": "Hispanic or Latino?",
          "type": "select",
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            },
            {
              "value": "decline",
              "label": "Decline to answer"
            }
          ]
        },
        {
          "key": "race_ethnicity",
          "label": "Race or ethnicity",
          "optional": true
        }
      ]
    },
    {
      "key": "eligibility",
      "title": "Eligibility",
      "fields": [
        {
          "key": "over_18",
          "label": "Are you 18 or older?",
          "optional": true,
          "type": "select",
          "boolean": true,
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        {
          "key": "previously_employed_here",
          "label": "Have you worked for the company you're applying to?",
          "optional": true,
          "type": "select",
          "boolean": true,
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ]
        },
        {
          "key": "non_compete",
          "label": "Subject to a restrictive covenant?",
          "optional": true,
          "type": "select",
          "boolean": true,
          "options": [
            {
              "value": "yes",
              "label": "Yes"
            },
            {
              "value": "no",
              "label": "No"
            }
          ],
          "hint": "Such as a non-compete or non-solicit agreement."
        }
      ]
    },
    {
      "key": "preferences",
      "title": "Preferences",
