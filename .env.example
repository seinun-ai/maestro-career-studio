# ---------------------------------------------------------------------------
# HOST PORTS. All three bind to 127.0.0.1 only — never 0.0.0.0 — because every
# endpoint is unauthenticated. Change the number if one is taken; do not change
# the interface. Containers keep listening on their own ports internally, so
# only the left-hand side of the mapping moves.
#
# Two of these defaults look odd and are deliberate:
#   8001, not 8000 — 8000 is the most contended port in development (uvicorn,
#     Django and `python -m http.server` all default to it), so mapping the
#     host side up by one avoids the collision most users would otherwise hit.
#   55432, not 5432 — 5432 collides with any locally installed PostgreSQL,
#     which is common. The prefix keeps the original recognisable.
# ---------------------------------------------------------------------------
BACKEND_HOST_PORT=8001
FRONTEND_HOST_PORT=3000
POSTGRES_HOST_PORT=55432

# THE ONLY SETTING WORTH EDITING BEFORE FIRST BOOT. Everything else below has a
# working default. You can also leave it blank and paste the key under
# Settings → Models in the web app — that is stored in the database and
# survives rebuilds.
#
# LEFT BLANK ON PURPOSE. It used to ship as `sk-...`, which is worse than
# empty: the backend reports `api_key_configured: true`, the UI shows a key is
# present, and then every LLM call 401s. Blank engages the documented No-Key
# Mode instead — deterministic scoring, rendering and tracking all work, KB
# seeding defers and retries on a later boot once you add a key.
OPENAI_API_KEY=
GEMINI_API_KEY=
#
# Three roles, and you can point them anywhere the catalog lists. What the
# author runs today: Gemini 3.5 Flash-Lite handles Fast (JD ingestion and the
# other high-volume passes) without trouble; with only a Gemini key, 3.7 Flash
# serves as Smart -- capable, a little pricey. On OpenAI, GPT-5.6 Luna is the
# value pick: cheap, slower. Model prices and tiers move constantly, so treat
# this as a starting point rather than advice with a shelf life.
#
# CHAT_MODEL is separate from SMART_MODEL because chat is the one role that
# needs STREAMING TOOL CALLS; a model that fails that test still does every
# other job. Set them to the same id if one model does both -- that is a
# supported and common setup, not a compromise.
FAST_MODEL=gemini-3.5-flash-lite
SMART_MODEL=gpt-5.6-luna
CHAT_MODEL=gpt-5.6-luna

# ------------------------------------------------------------------
# Run the models locally (optional). Any OpenAI-compatible server works:
# Ollama, LM Studio, vLLM, LiteLLM, OpenRouter. With a local endpoint no
# resume text ever leaves this machine.
#
# From inside the backend container, host Ollama is host.docker.internal:
#OPENAI_BASE_URL=http://host.docker.internal:11434/v1
#FAST_MODEL=llama3.2:3b
#SMART_MODEL=qwen2.5:14b
#
# Model ids become free text once this is set — we cannot enumerate what
# your server has pulled. Use Settings -> "Test" to measure what each model
# can actually do: text, JSON, and streaming tool calls are separate
# capabilities, and only the chat agent needs the third. A model that fails
# it still does everything else, so pointing chat_model at a cloud model
# while the rest stay local is a supported setup.
# ------------------------------------------------------------------

# ------------------------------------------------------------------
# Browser-facing security. This API has NO authentication, so these two
# settings are the entire boundary against attacks that come through the
# user's own browser. Read before changing either.
# ------------------------------------------------------------------

# Host header allowlist. Requests whose Host is not on it get a 400 before
# reaching any handler. This is the DNS-rebinding defence: a malicious site can
# make your browser send requests to 127.0.0.1, and if its domain re-resolves
# there the browser treats them as SAME-ORIGIN, so CORS is never consulted.
# Binding the port to 127.0.0.1 does not help — the browser is already inside.
# Defaults cover the compose stack; add your own hostname behind a proxy.
#ALLOWED_HOSTS=localhost,127.0.0.1,backend

# The SAME check, for the Next server on :3000 — and this is the one that
# matters, because that is the port your browser talks to. Next's /api route
# proxies to the backend and rebuilds the request, so the backend's own
# ALLOWED_HOSTS never sees the attacker's Host. Set both, or neither works.
#FRONTEND_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Browser ORIGINS allowed to call the API. CORS decides what a page may READ;
# this decides what it may RUN — a cross-origin form POST needs no preflight,
# so its write lands even when the browser refuses to show the page the reply.
# A host is `studio.lan`; an origin is `http://studio.lan`. Requests with NO
# Origin (MCP, curl, the healthcheck) are allowed: they are not browsers.
#ALLOWED_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Exact browser-extension ids allowed through CORS, comma-separated.
#
# YOU DO NOT NEED TO SET THIS. extension/manifest.json pins a `key`, so the
# bundled extension always loads with the id pjmfonfapjdabkoicnelpflpjojdjgan,
# and the backend already defaults to exactly that. Load unpacked and the card
# works — no id to copy, no restart.
#
# Set it only to point at a DIFFERENT build: a fork you re-keyed, or a Web Store
# install (Google assigns that id and it will not match the one above). The value
# REPLACES the default rather than extending it, so list every id you want,
# comma-separated. Do NOT use a wildcard: every extension you have installed
# would then be able to read the whole career record out of a zero-auth API.
#MAESTRO_CS_EXTENSION_IDS=pjmfonfapjdabkoicnelpflpjojdjgan,<other-id>
# One-release aliases: CAREER_STUDIO_EXTENSION_IDS (and other CAREER_STUDIO_*)
# still work if the matching MAESTRO_CS_* var is unset.

# The backend container runs as this uid/gid instead of root. It must own the
# bind-mounted data directories (applications/, base_resumes/, settings/, …) or
# they are unwritable. Linux users whose id is not 1000: set both, then rebuild.
# macOS/Windows Docker Desktop translate ownership — leave these alone.
#APP_UID=1000
#APP_GID=1000

# Container images. Build-first by default: `docker compose up -d --build`
# produces maestro-career-studio-{backend,frontend}:latest locally. Once prebuilt
# multi-arch images are published, set IMAGE_REGISTRY and the same compose
# file pulls them instead of building.
#IMAGE_REGISTRY=ghcr.io/seinun-ai/maestro-career-studio
#IMAGE_TAG=latest
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=maestro_cs

# Optional MCP host-side artifact locations.
#MAESTRO_CS_PDF_DIR=/absolute/path/to/pdf-inspection-copies
# Browser-upload copies default to <repo>/.playwright-mcp/uploads.
#MAESTRO_CS_UPLOAD_DIR=/absolute/path/to/playwright-uploads

# ------------------------------------------------------------------
# Langfuse LLM tracing (optional, off by default). No Langfuse stack ships with
# this repo — point these at an instance you already run (self-hosted or Cloud)
# and restart the backend. ALL THREE are required — keys without an explicit
# host fall back to Langfuse Cloud, so a stale placeholder pair left here would
# ship your prompts to a third party. docker-compose does not forward these at
# all; set them only when running the backend yourself.
# Traces include your prompts, i.e. your resume text: use a host you control.
# ------------------------------------------------------------------
#LANGFUSE_PUBLIC_KEY=pk-lf-your-project-key
#LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
#LANGFUSE_HOST=https://your-langfuse-host

# ------------------------------------------------------------------
# Full prompt/response logging (optional, OFF by default).
# The backend always writes a metadata line per LLM call to logs/llm_calls —
# model, attempt, sizes, duration, and a sha256 of each side. That is enough to
# debug what happened, without keeping a second permanent copy of your resume.
# Turning this on adds the actual prompt and response text to those files.
# It is a debugging mode: turn it off when you are done and delete the files.
# The backend logs a warning at startup while it is on.
# ------------------------------------------------------------------
#LLM_LOG_CONTENT=true
